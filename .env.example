# ── Database (PostgreSQL + TimescaleDB) ──────────────────────────────────────
# Matches docker-compose.yml credentials (user/password/db = pao).
# docker-compose maps the container's 5432 to host port 5433 to avoid
# clashing with a local Postgres install — adjust if you're using a
# different Postgres instance.
DATABASE_URL=postgresql://pao:pao@localhost:5433/pao

# ── Redis (BullMQ queue + pub/sub for live agent run streaming) ───────────────
# docker-compose maps the container's 6379 to host port 6380 — see note above.
REDIS_URL=redis://localhost:6380

# ── NextAuth ──────────────────────────────────────────────────────────────────
AUTH_SECRET=<generate with: openssl rand -base64 32>
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ── Ingestion API ─────────────────────────────────────────────────────────────
# Base URL of apps/api — used by the dashboard SSE proxy route
INGESTION_API_URL=http://localhost:3001
# Port apps/api listens on (default 3001)
PORT=3001

# ── Email Transport ──────────────────────────────────────────────────────────
# smtp (default, Mailpit) or resend (production)
EMAIL_TRANSPORT=smtp
# EMAIL_TRANSPORT=resend

# SMTP (used when EMAIL_TRANSPORT=smtp)
# Inside Docker: SMTP_HOST=mailpit
# From host:     SMTP_HOST=localhost
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=alerts@pao.local

# Resend (optional, only when EMAIL_TRANSPORT=resend)
# RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=alerts@yourdomain.com

# ── Dashboard ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000